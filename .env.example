# Root environment template for docker-compose (development defaults).
# Copy to .env and adjust. NEVER commit a real .env file.
# All values here are explicit placeholders, not real secrets.

APP_ENV=development

# PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=platform
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ACCESS_KEY=change-me-dev-only
MINIO_SECRET_KEY=change-me-dev-only

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability (only used with --profile observability)
GRAFANA_ADMIN_PASSWORD=change-me-dev-only