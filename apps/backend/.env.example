# Backend environment template (development defaults).
# Copy to .env and adjust. NEVER commit a real .env file.

APP_ENV=development
APP_NAME=security-assessment-platform
APP_VERSION=0.1.0
DEBUG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=platform

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me-dev-only
MINIO_SECRET_KEY=change-me-dev-only
MINIO_SECURE=false

# Auth / JWT (required in all environments)
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7